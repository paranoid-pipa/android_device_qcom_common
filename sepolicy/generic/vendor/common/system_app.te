# zram
allow system_app sysfs_zram:dir r_dir_perms;
allow system_app sysfs_zram:file r_file_perms;

# Allow system_app to read GPU and system stats
allow system_app vendor_sysfs_graphics:file { read open getattr };
allow system_app vendor_sysfs_kgsl:file { read open getattr };
allow system_app vendor_sysfs_kgsl_gpuclk:file { read open getattr };
